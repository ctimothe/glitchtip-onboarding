{
  "name": "glitchtip-onboarding-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --port 1420 --strictPort",
    "build": "tauri build",
    "build:frontend": "tsc --noEmit && vite build",
    "build:debug": "tauri build --debug --bundles app",
    "fetch:node": "bash scripts/fetch-node.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-http": "2.6.0",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-store": "2.4.4",
    "@tauri-apps/plugin-updater": "2.11.0",
    "lucide-react": "1.47.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.10.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
