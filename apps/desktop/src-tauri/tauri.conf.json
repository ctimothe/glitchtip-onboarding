{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlitchTip Companion",
  "version": "0.1.0",
  "identifier": "dev.ctimothe.glitchtip-onboarding",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GlitchTip Companion",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 20 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' https: ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist" },
    "externalBin": ["binaries/node"],
    "resources": ["../../../assets/relay", "../../../assets/agent-skill"]
  },
  "plugins": {}
}
