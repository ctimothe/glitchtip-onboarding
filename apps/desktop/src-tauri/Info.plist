<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the bundle's Info.plist by Tauri. The languages the app speaks, so AppKit's own
       menu items, alerts and file panels follow the Mac's language where macOS has it. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ru</string>
    <string>uz</string>
  </array>
</dict>
</plist>
