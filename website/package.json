{
  "name": "glitchtip-onboarding-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "check:samples": "node scripts/check-samples.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:samples && npm run build && npm run check:budgets"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.80",
    "framer-motion": "13.2.0",
    "gsap": "3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.185.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
